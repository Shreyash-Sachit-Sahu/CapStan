# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values here match the docker-compose.yml defaults so the stack runs as-is.

DB_PASSWORD=capstan_dev_only
RABBIT_PASSWORD=capstan_dev_only

# Phase 03 (diagnosis LLM fallback). Leave blank to run Tier 1 + Tier 2 only.
ANTHROPIC_API_KEY=

# Host port Postgres is published on. The container still listens on 5432;
# only the host-side mapping moved, because 5432 was already allocated here.
POSTGRES_HOST_PORT=15432
