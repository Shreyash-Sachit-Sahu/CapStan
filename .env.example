# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values here match the docker-compose.yml defaults so the stack runs as-is.

DB_PASSWORD=capstan_dev_only
RABBIT_PASSWORD=capstan_dev_only

# Diagnosis Tier 3 (the closed-set LLM classifier). Optional: leave both blank
# and the cascade runs its deterministic tiers only, abstaining to UNDIAGNOSED
# on the rest -- which is non-retryable, so a missing key can never read as
# permission to debit. On batch_holdout that is 75% of cases at 1.00 accuracy.
#
# Provider is chosen by whichever credential is present; set exactly one.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# The Postgres host port is deliberately NOT set here. It is 15432, fixed in
# two places that have to agree -- docker-compose.yml (the published mapping)
# and application.yml (the JDBC url). An override that moved only one of them
# would surface as an authentication error rather than a connection error,
# because Postgres reports an unknown role and a bad password identically.
