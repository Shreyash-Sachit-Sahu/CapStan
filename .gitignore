# Secrets — never commit. See docs/briefs/phase-09 hardening pass.
.env
*.pem

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.properties

# Node
node_modules/
.next/

# Python
__pycache__/
.venv/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated batches. Regenerable byte-identically from the seed
# (simulator/requirements.txt pins the versions); the manifests are the durable
# record of what a batch contained and ARE committed.
# Fixtures are committed. They are generated and deterministic -- `generate.py`
# with the same seed reproduces them byte for byte -- but a submission that
# cannot be run from a clean clone without a Python toolchain is not a
# submission. 5.4MB total, which is cheaper than the alternative.
tail -6 .gitignore

# Application logs. Never committed: they carry the resolved DB identity
# and can contain upstream error bodies.
*.log
*.err

# Next.js
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts

# Demo pre-flight logs
.demo-logs/

# Plugin/skill scaffolding, not part of the submission
.agents/
skills-lock.json
.impeccable/

# Phase briefs are the instructions to the build, not part of the submission
docs/briefs/
